# CodeWise settings. Copy to .env and change what you need:
#   cp .env.example .env
# Every value below is the default, so an empty .env works too.
# Read by `python backend.py` at startup (via python-dotenv).

# --- Models (Ollama) ------------------------------------------------------------
# Where Ollama runs.
# OLLAMA_HOST=http://127.0.0.1:11434
CODEWISE_CHAT_MODEL=qwen2.5-coder:7b
CODEWISE_EMBED_MODEL=nomic-embed-text
# Context window sent to Ollama, and how much of it is kept free for the answer.
CODEWISE_NUM_CTX=8192
CODEWISE_ANSWER_RESERVE=1536
# Seconds to wait for a model response.
CODEWISE_LLM_TIMEOUT=300
# Rewrite follow-up questions ("how does it work?") into standalone search queries.
CODEWISE_REWRITE_QUERIES=true

# --- Retrieval ------------------------------------------------------------------
CODEWISE_TOP_K=5
CODEWISE_CANDIDATE_K=20
# Cosine distance cutoff for vector matches (0 = identical, 2 = opposite).
CODEWISE_MAX_DISTANCE=0.75
CODEWISE_CHUNK_MAX_CHARS=1500
CODEWISE_CHUNK_OVERLAP_LINES=5

# --- Uploads and imports --------------------------------------------------------
CODEWISE_MAX_FILE_BYTES=1000000
CODEWISE_MAX_REQUEST_BYTES=100000000
CODEWISE_MAX_ARCHIVE_BYTES=100000000
CODEWISE_MAX_ARCHIVE_FILES=20000
CODEWISE_MAX_ARCHIVE_SOURCE_BYTES=200000000
# Needed for private GitHub repositories and higher rate limits.
# CODEWISE_GITHUB_TOKEN=

# --- Storage --------------------------------------------------------------------
# Relative paths are resolved from the folder you start the backend in.
# CODEWISE_CHROMA_PATH=
# CODEWISE_DB_PATH=
# Opt-in log of real questions and answers, for building test sets.
# CODEWISE_QUESTION_LOG=logs/questions.jsonl

# --- Server ---------------------------------------------------------------------
CODEWISE_HOST=127.0.0.1
CODEWISE_PORT=8000
# Browser origins allowed to call the API (the frontend's address).
CODEWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Never enable on a machine others can reach: the debugger allows running code.
CODEWISE_DEBUG=false
